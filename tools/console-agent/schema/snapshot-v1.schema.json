{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tyr1onX/lunar-cave-robot/tools/console-agent/schema/snapshot-v1.schema.json",
  "title": "Lunar Console NUC snapshot v1",
  "type": "object",
  "required": ["schema_version", "collected_at", "source", "host", "system", "git", "deployment", "ros", "tests", "safety"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "collected_at": {"type": "string", "format": "date-time"},
    "source": {"const": "nuc-read-only-agent"},
    "host": {
      "type": "object",
      "required": ["hostname", "platform", "os_release"],
      "additionalProperties": false,
      "properties": {
        "hostname": {"type": "string"},
        "platform": {"type": "string"},
        "os_release": {"type": "array", "items": {"type": "string"}}
      }
    },
    "system": {
      "type": "object",
      "required": ["cpu", "memory", "disk", "temperature"],
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "object", "required": ["status"], "additionalProperties": false,
          "properties": {"status": {"enum": ["ok", "unknown"]}, "percent": {"type": "number"}, "source": {"type": "string"}, "reason": {"type": "string"}}
        },
        "memory": {
          "type": "object", "required": ["status"], "additionalProperties": false,
          "properties": {"status": {"enum": ["ok", "unknown"]}, "total_bytes": {"type": "integer"}, "available_bytes": {"type": "integer"}, "used_percent": {"type": "number"}, "source": {"type": "string"}, "reason": {"type": "string"}}
        },
        "disk": {
          "type": "object", "required": ["status"], "additionalProperties": false,
          "properties": {"status": {"enum": ["ok", "unknown"]}, "path": {"type": "string"}, "total_bytes": {"type": "integer"}, "used_bytes": {"type": "integer"}, "free_bytes": {"type": "integer"}, "used_percent": {"type": "number"}, "reason": {"type": "string"}}
        },
        "temperature": {
          "type": "object", "required": ["status"], "additionalProperties": false,
          "properties": {
            "status": {"enum": ["ok", "unknown"]},
            "readings": {"type": "array", "items": {"type": "object", "required": ["label", "celsius", "source"], "additionalProperties": false, "properties": {"label": {"type": "string"}, "celsius": {"type": "number"}, "source": {"type": "string"}}}},
            "reason": {"type": "string"}
          }
        }
      }
    },
    "git": {
      "type": "object", "required": ["status"], "additionalProperties": false,
      "properties": {"status": {"enum": ["ok", "unknown"]}, "head_sha": {"type": "string"}, "branch": {"type": "string"}, "dirty": {"type": "boolean"}, "dirty_files": {"type": "integer"}, "repository_path": {"type": "string"}, "reason": {"type": "string"}}
    },
    "deployment": {
      "type": "object", "required": ["status"], "additionalProperties": false,
      "properties": {"status": {"enum": ["ok", "unknown"]}, "sha": {"type": "string"}, "source": {"type": "string"}, "reason": {"type": "string"}}
    },
    "ros": {
      "type": "object", "required": ["status", "domain_id", "nodes", "topics"], "additionalProperties": false,
      "properties": {
        "status": {"enum": ["ok", "unknown"]},
        "domain_id": {"type": ["integer", "null"]},
        "observed_at": {"type": ["string", "null"]},
        "graph_age_ms": {"type": ["integer", "null"]},
        "expected_domain_id": {"type": ["integer", "null"]},
        "expected_domain_error": {"type": ["string", "null"]},
        "expected_nodes": {"type": "array", "items": {"type": "string"}},
        "expected_nodes_error": {"type": ["string", "null"]},
        "nodes": {"type": "array", "items": {"type": "object", "required": ["name", "namespace"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "namespace": {"type": "string"}}}},
        "topics": {"type": "array", "items": {"type": "object", "required": ["name", "types"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "types": {"type": "array", "items": {"type": "string"}}}}},
        "discovery": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "workspaces": {
      "type": "object", "required": ["status", "source", "collected_at", "process_scan", "graph_source", "workspaces"], "additionalProperties": false,
      "properties": {
        "status": {"enum": ["ok", "unknown"]},
        "source": {"const": "nuc-read-only-workspace-and-process-observer"},
        "collected_at": {"type": "string", "format": "date-time"},
        "process_scan": {
          "type": "object", "required": ["status", "scope", "source", "observed_at", "reason"], "additionalProperties": false,
          "properties": {
            "status": {"enum": ["ok", "partial", "unknown"]},
            "scope": {"type": "string"}, "source": {"type": "string"},
            "observed_at": {"type": "string", "format": "date-time"},
            "reason": {"type": ["string", "null"]}
          }
        },
        "graph_source": {
          "type": "object", "required": ["domain_id", "observed_at", "graph_age_ms", "source"], "additionalProperties": false,
          "properties": {
            "domain_id": {"type": ["integer", "null"]},
            "observed_at": {"type": ["string", "null"]},
            "graph_age_ms": {"type": ["integer", "null"]},
            "source": {"type": "string"}
          }
        },
        "workspaces": {"type": "array", "items": {"$ref": "#/$defs/workspace"}}
      }
    },
    "tests": {
      "type": "object", "required": ["status", "records"], "additionalProperties": false,
      "properties": {
        "status": {"enum": ["ok", "unknown"]},
        "records": {"type": "array", "items": {
          "type": "object", "required": ["id", "timestamp", "result", "test", "scope", "sha", "branch", "artifact", "record_path"], "additionalProperties": false,
          "properties": {"id": {"type": "string"}, "timestamp": {"type": ["string", "null"]}, "result": {"type": "string"}, "test": {"type": "string"}, "scope": {"type": "string"}, "sha": {"type": ["string", "null"]}, "branch": {"type": ["string", "null"]}, "artifact": {"type": ["string", "null"]}, "record_path": {"type": "string"}}
        }},
        "source": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "safety": {
      "type": "object", "required": ["physical_estop", "hardware_health", "control"], "additionalProperties": false,
      "properties": {
        "physical_estop": {"$ref": "#/$defs/reading"},
        "hardware_health": {"$ref": "#/$defs/reading"},
        "control": {"const": "disabled"}
      }
    }
  },
  "$defs": {
    "workspace": {
      "type": "object",
      "required": ["id", "label", "source_kind", "root", "source_status", "source_observed_at", "package_count", "packages", "launch_count", "launch_files", "config_count", "config_files", "runtime_status", "execution_state", "runtime_scope", "runtime_observed_at", "process_count", "processes", "domain_ids", "run_mode", "run_expectation", "graph_domain_id", "graph_observed_at", "graph_relationship", "graph_reason", "modules", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"}, "label": {"type": "string"},
        "source_kind": {"enum": ["new", "original"]}, "root": {"type": "string"},
        "source_status": {"enum": ["present", "unknown"]}, "source_observed_at": {"type": "string", "format": "date-time"},
        "package_count": {"type": "integer"},
        "packages": {"type": "array", "items": {"type": "object", "required": ["name", "path"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "path": {"type": "string"}}}},
        "launch_count": {"type": "integer"}, "launch_files": {"type": "array", "items": {"type": "string"}},
        "config_count": {"type": "integer"}, "config_files": {"type": "array", "items": {"type": "string"}},
        "runtime_status": {"enum": ["running", "not_running", "unknown"]}, "runtime_scope": {"type": "string"},
        "execution_state": {"enum": ["not_running", "simulation_running", "hardware_declared_running", "unknown"]},
        "runtime_observed_at": {"type": "string", "format": "date-time"}, "process_count": {"type": "integer"},
        "processes": {"type": "array", "items": {"$ref": "#/$defs/workspace_process"}},
        "domain_ids": {"type": "array", "items": {"type": "integer"}},
        "run_mode": {"enum": ["hardware", "simulation", "offline", "read-only", "mixed", "unknown"]},
        "run_expectation": {"const": "unconfigured"},
        "graph_domain_id": {"type": ["integer", "null"]}, "graph_observed_at": {"type": ["string", "null"]},
        "graph_relationship": {"enum": ["shared_domain", "partially_shared", "different_domain", "unknown"]},
        "graph_reason": {"type": "string"},
        "modules": {"type": "array", "items": {"$ref": "#/$defs/workspace_module"}},
        "reason": {"type": ["string", "null"]}
      }
    },
    "workspace_process": {
      "type": "object", "required": ["pid", "process_name", "package", "domain_id", "domain_evidence", "localhost_only", "run_mode", "run_mode_evidence", "matched_by", "observed_at"], "additionalProperties": false,
      "properties": {
        "pid": {"type": "integer"}, "process_name": {"type": "string"},
        "package": {"type": ["string", "null"]}, "domain_id": {"type": ["integer", "null"]},
        "domain_evidence": {"enum": ["observed", "unset", "invalid", "unavailable"]}, "localhost_only": {"enum": ["0", "1", null]},
        "run_mode": {"enum": ["hardware", "simulation", "offline", "read-only", "unknown"]},
        "run_mode_evidence": {"enum": ["explicit_environment", "unknown"]},
        "matched_by": {"type": "array", "items": {"enum": ["working_directory", "executable_path", "command_path", "overlay_environment"]}},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "workspace_module": {
      "type": "object", "required": ["id", "label", "packages", "source_status", "runtime_status", "execution_state", "run_expectation", "interface_topics", "observed_interface_topics", "reason"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string"}, "label": {"type": "string"},
        "packages": {"type": "array", "items": {"type": "string"}},
        "source_status": {"enum": ["present", "unknown"]}, "runtime_status": {"enum": ["running", "not_running", "unknown"]},
        "execution_state": {"enum": ["not_running", "simulation_running", "hardware_declared_running", "unknown"]},
        "run_expectation": {"const": "unconfigured"},
        "interface_topics": {"type": "array", "items": {"type": "string"}},
        "observed_interface_topics": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"}
      }
    },
    "reading": {
      "type": "object", "required": ["status", "reason"], "additionalProperties": false,
      "properties": {"status": {"enum": ["ok", "unknown"]}, "reason": {"type": "string"}}
    }
  }
}
