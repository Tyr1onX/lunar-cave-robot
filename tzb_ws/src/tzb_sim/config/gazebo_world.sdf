<?xml version="1.0"?>
<sdf version="1.8">
  <world name="tzb_p2">
    <gravity>0 0 -1.62</gravity>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_contacts>128</max_contacts>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.20 0.22 0.24 1</ambient>
            <diffuse>0.24 0.26 0.29 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The table is a real collision surface, positioned at the chassis deck height. -->
    <model name="target_table">
      <static>true</static>
      <pose>0.51 0.20 0.209 0 0 0</pose>
      <link name="table_link">
        <collision name="table_collision">
          <geometry><box><size>0.38 0.32 0.02</size></box></geometry>
          <surface><friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction></surface>
        </collision>
        <visual name="table_visual">
          <geometry><box><size>0.38 0.32 0.02</size></box></geometry>
          <material>
            <ambient>0.28 0.24 0.18 1</ambient>
            <diffuse>0.42 0.34 0.23 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Physical drop-off pad under the planner's place-joint pose. -->
    <model name="place_pad">
      <static>true</static>
      <pose>0.13 -0.54 0.005 0 0 0</pose>
      <link name="place_pad_link">
        <collision name="place_pad_collision">
          <geometry><box><size>0.50 0.24 0.01</size></box></geometry>
          <surface><friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction></surface>
        </collision>
        <visual name="place_pad_visual">
          <geometry><box><size>0.50 0.50 0.01</size></box></geometry>
          <material>
            <ambient>0.85 0.28 0.02 1</ambient>
            <diffuse>1.0 0.36 0.02 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Dynamic 50 mm target; its pose is only advanced by Gazebo physics. -->
    <model name="blue_block">
      <pose>0.40 0.20 0.244 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>3.3333333e-5</ixx><iyy>3.3333333e-5</iyy><izz>3.3333333e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>2.0</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.01 0.08 0.95 1</ambient>
            <diffuse>0.02 0.16 1.0 1</diffuse>
            <specular>0.04 0.04 0.10 1</specular>
          </material>
        </visual>
        <sensor name="blue_block_contacts" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>/p2_gazebo/blue_block/contacts</topic>
          <contact><collision>collision</collision></contact>
        </sensor>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>0 0 4 0 0 0</pose>
      <direction>-0.4 0.3 -1</direction>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
    </light>
  </world>
</sdf>
